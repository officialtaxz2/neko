# Copy this file to .env on the deployment server and replace both passwords.
# .env is ignored by Git; never commit real credentials.

# Browser in the shared session: brave (default) or helium. setup.sh builds
# apps/<NEKO_BROWSER>; each browser keeps its own profile (Helium in the
# helium/ subdirectory of NEKO_PROFILE_DIR). Leave NEKO_IMAGE and
# NEKO_POLICY_FILE empty to follow NEKO_BROWSER.
NEKO_BROWSER=brave
NEKO_IMAGE=
NEKO_HTTP_BIND=127.0.0.1
NEKO_HTTP_PORT=8082
NEKO_WEBRTC_EPR=51000-51100
NEKO_DESKTOP_SCREEN=1920x1080@30

NEKO_PROFILE_DIR=./files
NEKO_DOWNLOADS_DIR=./downloads
NEKO_POLICY_FILE=

NEKO_MEMBER_MULTIUSER_USER_PASSWORD=
NEKO_MEMBER_MULTIUSER_ADMIN_PASSWORD=

# Optional. Generate without host OpenSSL through
# `docker compose -f docker-compose.validation.yaml run --rm token-generator`;
# leave empty to disable the server-enforced #/<16-character-token> view-only path.
NEKO_VIEW_ONLY_TOKEN=

# Set this when remote clients need an explicit reachable server address, then
# uncomment NEKO_WEBRTC_NAT1TO1 in docker-compose.yaml.
# NEKO_WEBRTC_NAT1TO1=203.0.113.10

# Compose files used by setup.sh and plain `docker compose` (colon-separated,
# base file first). This deployment enables adaptive quality and HLS by
# default; WebRTC stays the default media path for every client. For the
# plain upstream-like setup use only: COMPOSE_FILE=docker-compose.yaml
COMPOSE_FILE=docker-compose.yaml:docker-compose.adaptive.yaml:docker-compose.hls.yaml

# Used only with docker-compose.hls.yaml plus docker-compose.adaptive.yaml.
# Set one exact public https origin, e.g. https://neko.example, and only the
# immediate reverse-proxy address/CIDR that Neko actually sees. For Caddy/nginx
# on the same host this is the Docker network gateway, e.g. 172.18.0.1/32;
# setup.sh prints it. This deployment overlay intentionally accepts one of each.
# HTTPS is required.
NEKO_MEDIA_HLS_ALLOWED_ORIGINS=
NEKO_MEDIA_HLS_TRUSTED_PROXIES=
# Viewers can choose conventional HLS (~20 s delay) or LL-HLS (~3-5 s delay,
# needs HTTP/2 at the reverse proxy). Set 'hls' to offer only conventional HLS.
# Whitespace-separated, not CSV. deploy/check-ll-hls.sh verifies the LL path.
NEKO_MEDIA_HLS_MODES=hls ll-hls
NEKO_MEDIA_HLS_MAX_LEASES=128
NEKO_MEDIA_HLS_MAX_REQUESTS=512

#!/bin/bash
cd "$(dirname "$0")"

set -e
VITE_APP_SERVER_PORT="${VITE_APP_SERVER_PORT:-${VUE_APP_SERVER_PORT:-3000}}"

echo "Using VITE_APP_SERVER_PORT: ${VITE_APP_SERVER_PORT}"

# use -i to install
if [ ! -d "${PWD}/../node_modules" ] || [ "$1" == "-i" ]; then
  docker run --rm -it \
    --volume "${PWD}/../:/app" \
    --workdir="/app" \
    --entrypoint="npm" \
    node:18-bullseye-slim ci
fi

# Vite launcher; retain the legacy environment variable as an input alias.
docker run --rm -it \
    -p 3001:3000 \
    -e "VITE_APP_SERVER_PORT=$VITE_APP_SERVER_PORT" \
    --user "$(id -u):$(id -g)" \
    --volume "${PWD}/../:/app" \
    --entrypoint="npm" \
    --workdir="/app" \
    node:18-bullseye-slim run dev
